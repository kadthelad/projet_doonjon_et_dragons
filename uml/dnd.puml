@startuml

' Définition de la classe Vector
class Vector {
    + x : Integer
    + y : Integer

    + getPosX() : Integer
    + getPosY() : Integer
}

' Définition de la classe Personnage
class Personnage {
    + nom : String
    + race : Race
    + classe : Classe
    + pointsDeVie : Integer
    + force : Integer
    + dexterite : Integer
    + vitesse : Integer
    + initiative : Integer
    + inventaire : List<Equipement>
    + armeEquipee : Arme
    + armureEquipee : Armure

    + seDeplacer(distance : Integer) : void
    + attaquer(cible : Monstre) : void
    + sEquiper(equipement : Equipement) : void
    + ramasserEquipement(equipement : Equipement) : void
}

class Maitre {
    + monstres : List<Monstre>
}

' Définition de la classe Monstre
class Monstre {
    + espece : String
    + numero : Integer
    + attaques : List<Integer>
    + pointsDeVie : Integer
    + force : Integer
    + dexterite : Integer
    + classeArmure : Integer
    + initiative : Integer
}

' Définition de la classe Donjon
class Donjon {
    + carte : Carte
    + personnages : List<Personnage>
    + equipements : List<Equipement>

    + initialiserJeu() : void
    + jouerTour() : void
    + quitterJeu() : void
    + placerPersonnage(personnage : Personnage, position : Vector) : void
    + placerMonstre(monstre : Monstre, position : Vector) : void
    + placerEquipement(equipement : Equipement, position : Vector) : void
}

' Définition de la classe Carte
class Carte {
    + taille : Integer
    + obstacles : List<Vector>


    + afficherCarte(obstacles : List<Vector>, personnages : List<Personnage>, monstre : List<Monstre>, equipement : List<Equipement>)
}

' Définition des races
enum Race {
    Humain
    Nain
    Elfe
    Halfelin
}

' Définition des classes
enum Classe {
    Guerrier
    Clerc
    Magicien
    Roublard
}

' Définition de la classe Equipement
abstract class Equipement {
    + nom : String
}

' Définition de la classe Arme (hérite d'Equipement)
class Arme extends Equipement {
    + degats : String
    + portee : Integer
}

' Définition de la classe Armure (hérite d'Equipement)
class Armure extends Equipement {
    + classeArmure : Integer
}

' Définition de la classe Case
'class Case {
'    + x : Integer
'    + y : Integer
'    + estObstacle : Boolean
'    + contenu : ContenuCase
'
'    + estLibre() : Boolean
'}

' Définition des contenus possibles pour une case
'abstract class ContenuCase
'class PersonnageCase extends ContenuCase
'class MonstreCase extends ContenuCase
'class EquipementCase extends ContenuCase

' Relations entre les classes
Personnage "1" -- "1" Race
Personnage "1" -- "1" Classe
Personnage "1" o-- "1" Arme
Personnage "1" o-- "1" Armure
Personnage "1" o-- "1..*" Equipement

Maitre "1" -- "1" Monstre
Maitre "1" -- "1" Donjon

'Carte "1" o-- "1..*" Case
'Case "1" o-- "0..1" ContenuCase
Arme --|> Equipement
Armure --|> Equipement

Donjon "1" o-- "1" Carte
Donjon "1" o-- "1..*" Monstre

'ContenuCase <|-- PersonnageCase
'ContenuCase <|-- MonstreCase
'ContenuCase <|-- EquipementCase

@enduml
